# Copy this file to .env.local and fill in your Shopify credentials

# Shopify Configuration
# Your Shopify store domain (e.g., my-store.myshopify.com)
SHOPIFY_STORE_DOMAIN=

# Your Shopify Admin API Access Token
# Get this from: Shopify Admin > Settings > Apps > Develop apps
SHOPIFY_ADMIN_API_ACCESS_TOKEN=

# Shopify API Version (check latest at https://shopify.dev/api/usage/versioning)
SHOPIFY_API_VERSION=2025-10

# App Configuration
NEXT_PUBLIC_APP_URL=http://localhost:3000
