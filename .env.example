# Copy this file to .env.local and fill in your Shopify credentials

# Database
DATABASE_URL="file:./dev.db"

# Shopify Multi-Store Configuration
# Add tokens for each store you want to support
# Get tokens from: Shopify Admin > Settings > Apps > Develop apps
SHOPIFY_TOKEN_MALEN=shpat_your_malen_token_here
SHOPIFY_TOKEN_PAINTING=shpat_your_painting_token_here

# Shopify API Version (check latest at https://shopify.dev/api/usage/versioning)
SHOPIFY_API_VERSION=2025-01

# Authentication Secret
AUTH_SECRET=your_auth_secret_here

# App Configuration
NEXT_PUBLIC_APP_URL=http://localhost:3000
