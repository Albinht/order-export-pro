# Production Environment Variables Template
# Copy these to your Vercel project: Settings → Environment Variables

# Database (Turso) - REQUIRED
DATABASE_URL=libsql://order-export-db-albinht.aws-ap-northeast-1.turso.io
DATABASE_AUTH_TOKEN=your_turso_auth_token_here

# Shopify Store Tokens - REQUIRED
SHOPIFY_TOKEN_MALEN=shpat_your_malen_token_here
SHOPIFY_TOKEN_PAINTING=shpat_your_painting_token_here

# Shopify API Configuration
SHOPIFY_API_VERSION=2025-01

# Authentication Secret - REQUIRED
# Generate with: openssl rand -base64 32
AUTH_SECRET=your_random_32_char_secret_here

# App URL - Update with your Vercel URL
NEXT_PUBLIC_APP_URL=https://your-project.vercel.app

# ⚠️ IMPORTANT NOTES:
# 1. Get actual values from CREDENTIALS.local.md (local file, not in git)
# 2. Add these in Vercel for: Production, Preview, AND Development
# 3. After adding variables, redeploy WITHOUT build cache
# 4. Test with: https://your-project.vercel.app/api/health
