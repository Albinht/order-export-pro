# Production Database (gebruik Neon, Supabase of PlanetScale)
DATABASE_URL="postgresql://user:password@host:5432/database?sslmode=require"

# Alternative: MySQL voor PlanetScale
# DATABASE_URL="mysql://user:password@host:3306/database?ssl={"rejectUnauthorized":true}"

# Shopify Configuration
SHOPIFY_STORE_DOMAIN="your-store.myshopify.com"
SHOPIFY_ACCESS_TOKEN="shpat_xxxxx"
SHOPIFY_API_VERSION="2025-01"

# Authentication Secret (genereer met: openssl rand -base64 32)
NEXTAUTH_SECRET="your-random-secret-key-here"
NEXTAUTH_URL="https://your-domain.vercel.app"

# Security Settings
NODE_ENV="production"
SECURE_COOKIES="true"
SESSION_TIMEOUT="1800"

# Optional: Sentry for error tracking
SENTRY_DSN="https://xxx@xxx.ingest.sentry.io/xxx"
