# Cloudflare Pages Environment Variables
# Voeg deze toe in Cloudflare Dashboard → Settings → Environment Variables

# Turso Database (SQLite in the cloud)
DATABASE_URL=libsql://your-database-name.turso.io
DATABASE_AUTH_TOKEN=your-turso-auth-token

# Shopify Configuration  
SHOPIFY_STORE_DOMAIN=your-store.myshopify.com
SHOPIFY_ACCESS_TOKEN=shpat_your_access_token_here
SHOPIFY_API_VERSION=2025-01

# Simple Auth (genereer met: openssl rand -base64 32)
AUTH_SECRET=your-random-32-char-secret

# App URL (wordt automatisch gezet door Cloudflare)
NEXT_PUBLIC_APP_URL=https://order-export.pages.dev
