# SUPER SIMPELE VERCEL SETUP - ALLEEN DEZE 2 DINGEN AANPASSEN!
# 
# Stap 1: Kopieer deze hele tekst
# Stap 2: Plak in Vercel Environment Variables
# Stap 3: Vervang alleen de [JOUW_TOKEN] en [JOUW_STORE]
# Stap 4: Deploy!

# 🔥 DATABASE - NIET AANPASSEN! Werkt automatisch
DATABASE_URL=file:./prisma/database.db

# 🏪 SHOPIFY - PAS DIT AAN MET JOUW GEGEVENS
SHOPIFY_STORE_DOMAIN=[JOUW_STORE].myshopify.com
SHOPIFY_ACCESS_TOKEN=shpat_[JOUW_TOKEN]
SHOPIFY_API_VERSION=2025-01

# 🔐 AUTH - NIET AANPASSEN! Deze secret is veilig
AUTH_SECRET=xK9mN3pQ7vB2wF5zL8hG4jR6tY1sD0aE

# 🌐 APP URL - Wordt automatisch ingevuld door Vercel
NEXT_PUBLIC_APP_URL=$VERCEL_URL

# ✅ KLAAR! Deploy nu je app
